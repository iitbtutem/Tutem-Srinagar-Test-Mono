{
  "name": "tutem",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "nohoist": [
      "**/@radix-ui/**",
      "**/react/**",
      "**/react-dom/**",
      "**/react",
      "**/react-dom",
      "user-app",
      "user-app/**",
      "driver-app",
      "driver-app/**"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "convex": "^1.32.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "yarn": "1.x"
  },
  "packageManager": "yarn@1.22.22"
}
