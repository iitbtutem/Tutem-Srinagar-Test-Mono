{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@tutem/typescript-config/base.json",
    "compilerOptions": {
        "noEmit": true
    },
    "include": [
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules",
        "**/dist",
        "**/.next",
        "**/.expo"
    ]
}